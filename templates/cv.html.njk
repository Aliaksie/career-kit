<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>{{ view.person.name }}</title>
<style>
@page{size:A4;margin:15mm 17mm}
*{box-sizing:border-box}body{font:9.5pt/1.38 Arial,sans-serif;color:#243247;margin:0 auto;max-width:178mm}h1{font-size:25pt;letter-spacing:-.7pt;color:#14283f;margin:0 0 3pt}h2{font-size:10.5pt;text-transform:uppercase;letter-spacing:1pt;color:#245775;border-bottom:1px solid #c5d2dc;margin:13pt 0 6pt;padding-bottom:3pt}h3{font-size:11pt;color:#14283f;margin:9pt 0 2pt}h4{font-size:10pt;margin:7pt 0 2pt}h1,h2,h3,h4{break-after:avoid}p{margin:3pt 0 5pt}ul{margin:3pt 0 6pt;padding-left:14pt}li{margin:2pt 0;break-inside:avoid}a{color:inherit;text-decoration:none}.headline{font-size:12pt}.contacts,.dates{color:#526579;font-size:9pt}.role-heading{display:flex;justify-content:space-between;gap:12pt;align-items:baseline;break-after:avoid}.role-title{font-weight:bold}.skill{margin:2pt 0}.earlier{font-size:9pt;color:#526579}.credentials{font-size:9pt}.credentials ul{columns:2;column-gap:18pt}@media screen{body{padding:30px;max-width:850px;background:white}html{background:#e9eef2}}
</style></head><body>
<header><h1>{{ view.person.name }}</h1><p class="headline">{{ view.person.headline }}</p>{% if view.person.contacts.length %}<p class="contacts">{{ view.person.contacts | join(' · ') }}</p>{% endif %}{% if view.person.summary %}<p>{{ view.person.summary }}</p>{% endif %}</header>
{% if view.skills.length %}<section><h2>Core expertise</h2>{% for group in view.skills %}<p class="skill"><strong>{{ group.label }}:</strong> {{ group.items | join(', ') }}</p>{% endfor %}</section>{% endif %}
{% if view.experiences.length %}<section><h2>Professional experience</h2>{% for role in view.experiences %}<div class="role-heading"><h3>{{ role.organization }}</h3><span class="dates">{{ role.dates }}</span></div><p class="role-title">{{ role.title }}</p>{% for project in role.projects %}<article><h4>{{ project.name }}</h4><p>{{ project.description }}</p>{% if project.bullets.length %}<ul>{% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}</article>{% endfor %}{% if role.earlier.length %}<p class="earlier"><strong>Other assignments:</strong> {% for project in role.earlier %}{{ project.name }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>{% endif %}{% endfor %}</section>{% endif %}
{% if view.projects.length %}<section><h2>Selected projects</h2>{% for project in view.projects %}<article><h3>{{ project.name }}</h3><p>{{ project.description }}</p><ul>{% for bullet in project.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul></article>{% endfor %}</section>{% endif %}
{% if view.openSource.length %}<section><h2>Selected open source</h2><ul>{% for project in view.openSource %}<li><strong>{{ project.name }}</strong>{% if project.summary %} — {{ project.summary }}{% elif project.description %} — {{ project.description }}{% endif %}</li>{% endfor %}</ul></section>{% endif %}
{% if view.education.length %}<section class="credentials"><h2>Education</h2>{% for item in view.education %}<p>{{ item }}</p>{% endfor %}</section>{% endif %}
{% if view.certifications.length %}<section class="credentials"><h2>Selected certifications</h2><ul>{% for item in view.certifications %}<li>{{ item }}</li>{% endfor %}</ul></section>{% endif %}
</body></html>
