{
  "name": "career-kit",
  "version": "0.2.0",
  "description": "Evidence-grounded career profile compiler",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.5",
  "bin": {
    "career": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "templates",
    "prompts",
    "src/schema",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && vitest run dist/tests --maxWorkers=2",
    "career": "tsx src/cli/index.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:package": "pnpm build && node scripts/check-package.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/openai": "^4.0.99",
    "@ai-sdk/openai-compatible": "^3.0.75",
    "ai": "^7.0.148",
    "commander": "14.0.3",
    "nunjucks": "3.2.4",
    "playwright": "1.60.0",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "6.4.3",
    "vitest": "4.1.8"
  }
}
